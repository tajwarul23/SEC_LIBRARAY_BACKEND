# Copy to .env and fill in. Never commit .env.
# On Render, set the same variables in the service's Environment tab.

# ===== Core =====
# development locally; production on Render (enables Secure/SameSite=None
# cookies for the cross-site Vercel frontends and turns password login off)
NODE_ENV=development
# Local port. Don't set on Render (Render provides PORT).
PORT=5000
# MongoDB connection string, including the database name
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/sec_library?retryWrites=true&w=majority
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# Frontend origins allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:3000
STUDENT_CLIENT_URL=http://localhost:5173
# Public URL of this backend (SSLCommerz callbacks). Render: https://<app>.onrender.com
BACKEND_URL=http://localhost:5000

# Local-development password login fallback (regNo + password).
# Only works when NODE_ENV isn't production. Never set on Render.
ALLOW_PASSWORD_LOGIN=true

# ===== Firebase Admin (student Google sign-in) =====
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n sequences exactly as in the downloaded JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== Library assistant (RAG chatbot) =====
# Optional: without these the chatbot answers "not available" and indexing
# is skipped. After changing rag.text, rebuild with `npm run rag:index`.
QDRANT_URL_RAG=
QDRANT_API_KEY_RAG=
# Google AI Studio key (embeddings)
GOOGLE_API_KEY=
# Groq key (answers)
GROQ_API_KEY_RAG=

# ===== SSLCommerz (sandbox only — fine payments) =====
# Sandbox store from https://developer.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# ===== Library rules (optional — defaults shown) =====
# RESERVATION_HOLD_MINUTES=2
# RESERVATION_EXPIRY_FINE=20
# LOAN_DURATION_DAYS=7
# LATE_FINE_PER_DAY=5
# Late fines only count from this date (set to your deployment date so
# books already overdue before launch aren't charged retroactively)
# LATE_FINES_START_DATE=2026-09-29T00:00:00Z
